{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.85",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@0.4.0"
      ],
      "environment": {
        "NEXT_TELEMETRY_DISABLED": "1"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.13.0",
        "--no-usage-statistics",
        "--headless",
        "--isolated"
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "enabled": false
    },
    "agentation": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "agentation-mcp@1.3.2",
        "server"
      ],
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false
    }
  }
}
